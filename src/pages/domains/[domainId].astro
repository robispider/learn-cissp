---
import type { GetStaticPaths } from 'astro';
import AppShell from '../../components/layout/AppShell.astro';
import DomainHub from '../../components/catalog/DomainHub';
import { loadCatalog, taxonomy } from '../../lib/load-catalog';

export const getStaticPaths: GetStaticPaths = async () =>
  taxonomy.domains.map((dom) => ({ params: { domainId: dom.domainId } }));

const { domainId } = Astro.params;
const catalog = await loadCatalog();
const domain = catalog.domains.find((d) => d.domainId === domainId)!;
---

<AppShell title={`Domain ${domain.number}: ${domain.name} — Learn CISSP`} description={domain.tagline}>
  <DomainHub client:load catalog={catalog} domainId={domain.domainId} />
</AppShell>
