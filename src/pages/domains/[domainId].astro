---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import AppShell from '../../components/layout/AppShell.astro';
import ExamBrowserHub from '../../components/catalog/ExamBrowserHub';
import taxonomy from '../../content/taxonomy/cissp-cbk-2026.json';

export const getStaticPaths: GetStaticPaths = async () => {
  return taxonomy.domains.map((dom) => ({
    params: { domainId: dom.domainId },
    props: { domain: dom },
  }));
};

interface Props {
  domain: (typeof taxonomy.domains)[number];
}

const { domain } = Astro.props;
const exams = await getCollection('exams');
const questions = await getCollection('questions');

const allExams = exams.map((e) => e.data).sort((a, b) => a.examId.localeCompare(b.examId));
const allQuestions = questions.map((q) => q.data);
const domain1Exam = allExams.find((e) => e.examId === 'd1-full-01')!;
const domain1Questions = allQuestions.filter((q) => q.domainId === 'dom-1');
---

<AppShell
  title={`Domain ${domain.number}: ${domain.name} — Learn CISSP`}
  description={domain.tagline}
>
  <ExamBrowserHub
    client:load
    domains={taxonomy.domains}
    domain1Exam={domain1Exam}
    domain1Questions={domain1Questions}
    allExams={allExams}
    allQuestions={allQuestions}
    initialTab="subdomain"
    initialDomainFilter={domain.domainId}
  />
</AppShell>
