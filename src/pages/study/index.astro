---
import AppShell from '../../components/layout/AppShell.astro';
import StudyExplorer, { type StudyTakeaway } from '../../components/catalog/StudyExplorer';
import InteractiveConceptDeck from '../../components/catalog/InteractiveConceptDeck';
import { loadCatalog, loadQuestions } from '../../lib/load-catalog';

const catalog = await loadCatalog();
const questions = await loadQuestions();

// Key takeaways come straight from the question bank, so they grow as questions are added.
const seen = new Set<string>();
const takeaways: StudyTakeaway[] = [];
for (const q of [...questions].sort((a, b) => a.topicId.localeCompare(b.topicId, undefined, { numeric: true }))) {
  const text = q.explanation.keyTakeaway.trim();
  if (seen.has(text)) continue;
  seen.add(text);
  takeaways.push({ subdomainId: q.subdomainId, topicId: q.topicId, text });
}
---

<AppShell title="Study map — Learn CISSP">
  <div class="mx-auto max-w-6xl px-4 pb-16 pt-8 sm:px-6 sm:pt-12">
    <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-3xl">Study map</h1>
    <p class="mt-1 max-w-2xl text-sm text-slate-500 dark:text-slate-400">
      Browse the whole CBK, read key takeaways for each sub-domain, and jump into a drill when you are ready.
    </p>
    <div class="mt-8">
      <StudyExplorer client:load catalog={catalog} takeaways={takeaways} />
    </div>
    <div class="mt-16">
      <InteractiveConceptDeck client:visible />
    </div>
  </div>
</AppShell>
