---
import '../../styles/global.css';
import { BarChart3, BookOpenText, ClipboardList, House } from 'lucide-react';
import ResumeExamBanner from './ResumeExamBanner';
import ThemeToggle from './ThemeToggle';
import { stripBase, withBase } from '../../lib/paths';

interface Props {
  title?: string;
  description?: string;
  minimalChrome?: boolean;
}

const {
  title = 'Learn CISSP — Practice exams & study',
  description = 'Blueprint-weighted CISSP practice exams with per-option explanations and a clear picture of your gaps. Everything stays in your browser.',
  minimalChrome = false,
} = Astro.props;

const pathname = stripBase(Astro.url.pathname);
const nav = [
  { href: withBase('/'), label: 'Home', Icon: House, active: pathname === '/' },
  {
    href: withBase('/exams'),
    label: 'Exams',
    Icon: ClipboardList,
    active: pathname.startsWith('/exams') || pathname.startsWith('/domains'),
  },
  { href: withBase('/study'), label: 'Study', Icon: BookOpenText, active: pathname.startsWith('/study') },
  {
    href: withBase('/history'),
    label: 'Progress',
    Icon: BarChart3,
    active: pathname.startsWith('/history') || pathname.startsWith('/results'),
  },
];
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0a0d14" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="format-detection" content="telephone=no" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        const raw = localStorage.getItem('cissp:user_preferences');
        const theme = raw ? JSON.parse(raw).theme : 'dark';
        document.documentElement.classList.toggle('dark', theme !== 'light');
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', theme === 'light' ? '#f7f8fa' : '#0a0d14');
      } catch (e) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body
    class:list={[
      'min-h-screen bg-[var(--bg-canvas)] text-slate-900 antialiased selection:bg-emerald-500/20 dark:text-slate-100',
      !minimalChrome && 'pb-mobile-nav sm:pb-0',
    ]}
  >
    {
      !minimalChrome && (
        <>
          <ResumeExamBanner client:load />
          <header class="sticky top-0 z-40 border-b border-slate-200/70 bg-[var(--bg-canvas)]/80 pt-[env(safe-area-inset-top)] backdrop-blur-xl dark:border-slate-800/70">
            <div class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-2 px-4 sm:gap-4 sm:px-6">
              <a href={withBase('/')} class="flex shrink-0 items-center gap-2">
                <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-500 text-slate-950">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-4 w-4"
                  >
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10" />
                    <path d="m9 12 2 2 4-4" />
                  </svg>
                </span>
                <span class="text-sm font-bold tracking-tight">
                  Learn<span class="text-emerald-500">CISSP</span>
                </span>
              </a>

              {/* Desktop / tablet navigation. Phones use the bottom tab bar below. */}
              <nav class="hidden min-w-0 items-center gap-0.5 sm:flex" aria-label="Main">
                {nav.map((item) => (
                  <a
                    href={item.href}
                    aria-current={item.active ? 'page' : undefined}
                    class:list={[
                      'shrink-0 rounded-lg px-3 py-1.5 text-sm font-medium transition',
                      item.active
                        ? 'bg-slate-900/5 text-slate-900 dark:bg-white/10 dark:text-white'
                        : 'text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white',
                    ]}
                  >
                    {item.label}
                  </a>
                ))}
              </nav>

              <ThemeToggle client:load />
            </div>
          </header>
        </>
      )
    }

    <main>
      <slot />
    </main>

    {
      !minimalChrome && (
        <>
          <footer class="border-t border-slate-200/70 py-8 text-xs text-slate-500 dark:border-slate-800/70">
            <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-4 text-center sm:flex-row sm:px-6 sm:text-left">
              <p>LearnCISSP · Your progress is stored only in this browser.</p>
              <a href={withBase('/history')} class="hover:text-slate-800 dark:hover:text-slate-300">
                Back up or restore progress
              </a>
            </div>
          </footer>

          {/* Mobile bottom tab bar (thumb-reachable, clears the iPhone home indicator). */}
          <nav
            aria-label="Main"
            class="pb-safe fixed inset-x-0 bottom-0 z-40 border-t border-slate-200/70 bg-[var(--bg-canvas)]/90 backdrop-blur-xl sm:hidden dark:border-slate-800/70"
          >
            <ul class="grid h-16 grid-cols-4">
              {nav.map(({ href, label, Icon, active }) => (
                <li>
                  <a
                    href={href}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'flex h-full flex-col items-center justify-center gap-1 text-[11px] font-medium transition',
                      active
                        ? 'text-emerald-600 dark:text-emerald-400'
                        : 'text-slate-500 active:text-slate-900 dark:text-slate-400 dark:active:text-white',
                    ]}
                  >
                    <span
                      class:list={[
                        'flex h-7 w-12 items-center justify-center rounded-full transition',
                        active && 'bg-emerald-500/15',
                      ]}
                    >
                      <Icon className="h-5 w-5" strokeWidth={active ? 2.4 : 2} />
                    </span>
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </>
      )
    }
  </body>
</html>
