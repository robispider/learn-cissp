---
import '../../styles/global.css';
import ResumeExamBanner from './ResumeExamBanner';
import ThemeToggle from './ThemeToggle';

interface Props {
  title?: string;
  description?: string;
  minimalChrome?: boolean;
}

const {
  title = 'Learn CISSP — Practice exams & study',
  description = 'Blueprint-weighted CISSP practice exams with per-option explanations and a clear picture of your gaps. Everything stays in your browser.',
  minimalChrome = false,
} = Astro.props;

const pathname = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Home', active: pathname === '/' },
  { href: '/exams', label: 'Exams', active: pathname.startsWith('/exams') || pathname.startsWith('/domains') },
  { href: '/study', label: 'Study', active: pathname.startsWith('/study') },
  { href: '/history', label: 'Progress', active: pathname.startsWith('/history') || pathname.startsWith('/results') },
];
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        const raw = localStorage.getItem('cissp:user_preferences');
        const theme = raw ? JSON.parse(raw).theme : 'dark';
        document.documentElement.classList.toggle('dark', theme !== 'light');
      } catch (e) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="min-h-screen bg-[var(--bg-canvas)] text-slate-900 antialiased selection:bg-emerald-500/20 dark:text-slate-100">
    {!minimalChrome && (
      <>
        <ResumeExamBanner client:load />
        <header class="sticky top-0 z-40 border-b border-slate-200/70 bg-[var(--bg-canvas)]/80 backdrop-blur-xl dark:border-slate-800/70">
          <div class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-2 px-4 sm:gap-4 sm:px-6">
            <a href="/" class="flex shrink-0 items-center gap-2">
              <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-500 text-slate-950">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10" />
                  <path d="m9 12 2 2 4-4" />
                </svg>
              </span>
              <span class="hidden text-sm font-bold tracking-tight sm:inline">
                Learn<span class="text-emerald-500">CISSP</span>
              </span>
            </a>

            <nav class="flex min-w-0 items-center gap-0.5 overflow-x-auto" aria-label="Main">
              {nav.map((item) => (
                <a
                  href={item.href}
                  aria-current={item.active ? 'page' : undefined}
                  class:list={[
                    'shrink-0 rounded-lg px-2.5 py-1.5 text-sm font-medium transition sm:px-3',
                    item.active
                      ? 'bg-slate-900/5 text-slate-900 dark:bg-white/10 dark:text-white'
                      : 'text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white',
                  ]}
                >
                  {item.label}
                </a>
              ))}
            </nav>

            <ThemeToggle client:load />
          </div>
        </header>
      </>
    )}

    <main>
      <slot />
    </main>

    {!minimalChrome && (
      <footer class="border-t border-slate-200/70 py-8 text-xs text-slate-500 dark:border-slate-800/70">
        <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-4 sm:flex-row sm:px-6">
          <p>LearnCISSP · Your progress is stored only in this browser.</p>
          <a href="/history" class="hover:text-slate-800 dark:hover:text-slate-300">Back up or restore progress</a>
        </div>
      </footer>
    )}
  </body>
</html>
